---
import Base from '../layouts/Base.astro';
---
<Base title="Ryan Gip Soong · pick a side" description="Ryan Gip Soong: web operations on the left brain, photography and side projects on the right.">
<main id="main">
<div class="base-dark home-grid" aria-hidden="true"></div>
<div class="flood-l" aria-hidden="true"><div class="home-grid"></div><div class="scan"></div></div>
<div class="flood-r" aria-hidden="true"><div class="blob b1"></div><div class="blob b2"></div><div class="blob b5"></div><div class="blob b3"></div><div class="blob b4"></div></div>

<div class="brain" aria-hidden="true">
<svg viewBox="0 0 400 440">
  <g class="hemi l" data-side="left" filter="url(#rough)">
    <path class="hit" d="M196 40 C130 30 70 70 56 140 C42 200 40 250 58 310 C76 370 130 410 196 404 Z"/>
    <path class="outline" d="M196 40 C130 30 70 70 56 140 C42 200 40 250 58 310 C76 370 130 410 196 404 C190 360 200 320 192 280 C186 240 200 200 192 160 C186 120 200 80 196 40 Z"/>
    <path class="trace draw" pathLength="1" style="--k:0" d="M176 84 H138 V118 H100"/>
    <path class="trace draw" pathLength="1" style="--k:1" d="M174 150 H122 V190 H80"/>
    <path class="trace draw" pathLength="1" style="--k:2" d="M178 222 H148 V262 H92"/>
    <path class="trace draw" pathLength="1" style="--k:3" d="M174 296 H132 V338 H112"/>
    <path class="trace draw" pathLength="1" style="--k:4" d="M150 362 V384 H176"/>
    <circle class="node" style="--k:0" cx="100" cy="118" r="4.5"/>
    <circle class="node" style="--k:1" cx="80" cy="190" r="4.5"/>
    <circle class="node" style="--k:2" cx="92" cy="262" r="4.5"/>
    <circle class="node" style="--k:3" cx="112" cy="338" r="4.5"/>
    <circle class="node" style="--k:4" cx="176" cy="384" r="4.5"/>
  </g>
  <g class="hemi r" data-side="right" filter="url(#rough)">
    <path class="hit" d="M204 40 C270 30 330 70 344 140 C358 200 360 250 342 310 C324 370 270 410 204 404 Z"/>
    <path class="outline" d="M204 40 C272 28 334 72 346 142 C360 204 358 252 340 312 C322 372 268 412 204 404 C210 360 200 320 208 280 C214 240 200 200 208 160 C214 120 200 80 204 40 Z"/>
    <path class="scrib draw c1" pathLength="1" style="--k:0" d="M222 82 C250 60 276 102 298 88 S332 118 318 142"/>
    <path class="scrib draw c2" pathLength="1" style="--k:1" d="M218 142 C246 120 260 172 290 152 S336 170 326 202"/>
    <path class="scrib draw c3" pathLength="1" style="--k:2" d="M224 212 C262 190 250 252 290 236 S340 252 330 282"/>
    <path class="scrib draw c4" pathLength="1" style="--k:3" d="M220 282 C252 270 266 322 294 302 S322 340 300 362"/>
    <path class="scrib draw c5" pathLength="1" style="--k:4" d="M240 366 C262 350 276 388 252 392 C240 394 238 380 248 378"/>
  </g>
</svg>
</div>
<div class="paws" aria-hidden="true" id="paws"></div>
<svg class="doodle" filter="url(#rough)" style="--d:.55s;left:62%;top:22%" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 2v6M12 16v6M2 12h6M16 12h6M5 5l3 3M16 16l3 3M19 5l-3 3M8 16l-3 3"/></svg>
<svg class="doodle" filter="url(#rough)" style="--d:.7s;left:84%;top:38%;color:var(--p-green)" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M3 12c3-6 6 6 9 0s6 6 9 0"/></svg>
<svg class="doodle" filter="url(#rough)" style="--d:.85s;left:72%;top:14%;color:var(--p-blue)" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="12" cy="12" r="7"/></svg>

<div class="top">
  <h1 class="pill">RYAN GIP SOONG <span class="sr-only">, web operations and photography</span></h1>
  <div class="hint">pick a hemisphere</div>
</div>

<a class="side l" href="/work" id="linkL">
  <span class="eyebrow"><span class="type">LEFT BRAIN</span></span>
  <h2><span class="line"><span>Logic, launches</span></span><span class="line"><span>&amp; uptime.</span></span></h2>
  <p>Web operations, development and go-live. CV first, case studies after.</p>
  <span class="go"><span class="type">cd /work</span><span class="caret" aria-hidden="true"></span></span>
</a>
<a class="side r" href="/play" id="linkR">
  <span class="cat" aria-hidden="true">
    <svg width="96" height="64" viewBox="0 0 96 64">
      <g fill="#222222">
        <path class="ear-l" d="M20 40 L26 10 L42 28 Z"/>
        <path class="ear-r" d="M76 40 L70 10 L54 28 Z"/>
        <ellipse cx="48" cy="52" rx="32" ry="26"/>
      </g>
      <path d="M27 18 L28 30 L36 27 Z M69 18 L68 30 L60 27 Z" fill="#EE94BC"/>
      <ellipse cx="37" cy="42" rx="5" ry="6" fill="#F2C14E"/><ellipse cx="59" cy="42" rx="5" ry="6" fill="#F2C14E"/>
      <ellipse cx="37" cy="43" rx="1.8" ry="4.6" fill="#222222"/><ellipse cx="59" cy="43" rx="1.8" ry="4.6" fill="#222222"/>
      <g class="lids" fill="#222222"><rect x="30" y="35" width="14" height="14"/><rect x="52" y="35" width="14" height="14"/></g>
      <path d="M45 51 L51 51 L48 54 Z" fill="#EE94BC"/>
      <path d="M22 50 L8 47 M22 54 L9 56 M74 50 L88 47 M74 54 L87 56" stroke="#FBFAF6" stroke-width="1.2" stroke-linecap="round" opacity=".7"/>
    </svg>
  </span>
  <span class="eyebrow">RIGHT BRAIN</span>
  <h2 id="rh">Light, colour<br>&amp; cats.</h2>
  <p>Photography and side projects. The stuff I do for fun.</p>
  <span class="go"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg> wander over to /play</span>
</a>
</main>
<script is:inline>
(function(){
const body=document.body, root=document.documentElement;
const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;

// split the right headline into letters so each can hop
(function(){
  const h=document.getElementById('rh'); h.setAttribute('aria-label',h.textContent.replace(/\s+/g,' '));
  let i=0; const out=[];
  h.innerHTML.split(/(<br>)/).forEach(part=>{
    if(part==='<br>'){out.push('<br>');return;}
    const tmp=document.createElement('span'); tmp.innerHTML=part;
    for(const c of tmp.textContent) out.push('<span class="ch" aria-hidden="true" style="--i:'+(i++)+'">'+(c===' '?' ':c.replace('&','&amp;'))+'</span>');
  });
  h.innerHTML=out.join('');
})();
// paw prints trotting along the bottom
(function(){
  const box=document.getElementById('paws');
  const svg='<svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><ellipse cx="12" cy="15" rx="5" ry="4.2"/><circle cx="6" cy="9" r="2.1"/><circle cx="10" cy="5.8" r="2.1"/><circle cx="14" cy="5.8" r="2.1"/><circle cx="18" cy="9" r="2.1"/></svg>';
  for(let i=0;i<7;i++){
    const p=document.createElement('span'); p.className='paw'; p.innerHTML=svg;
    p.style.cssText='--i:'+i+';--r:'+(80+(i%2?12:-12))+'deg;left:'+(6+i*7)+'%;top:'+(i%2?26:4)+'px';
    box.appendChild(p);
  }
})();

let state=null;
function setSide(s, x, y){
  if(s && s!==state && x!=null){ root.style.setProperty('--cx',x+'px'); root.style.setProperty('--cy',y+'px'); }
  state=s||null;
  if(s) body.dataset.side=s; else delete body.dataset.side;
}
function go(side){ location.href = side==='left' ? '/work' : '/play'; }
let labelSide=null, hovered=null;
[['linkL','left'],['linkR','right']].forEach(([id,s])=>{
  const a=document.getElementById(id);
  const on=()=>{labelSide=s; const r=a.getBoundingClientRect(); setSide(s, s==='left'?r.left+40:r.right-40, r.top);};
  const off=()=>{labelSide=null; setSide(hovered);};
  a.addEventListener('mouseenter',on); a.addEventListener('focus',on);
  a.addEventListener('mouseleave',off); a.addEventListener('blur',off);
});

// hemispheres of the line drawing pick a side; touch needs a tap to preview, a second tap to enter
let touchSel=null, lastPointer='mouse';
addEventListener('pointerdown',e=>{lastPointer=e.pointerType},true);
document.querySelectorAll('.hemi').forEach(h=>{
  const s=h.dataset.side;
  h.addEventListener('pointerenter',e=>{ if(e.pointerType==='touch') return; hovered=s; if(!labelSide) setSide(s,e.clientX,e.clientY); });
  h.addEventListener('pointerleave',e=>{ if(e.pointerType==='touch') return; hovered=null; if(!labelSide) setSide(null); });
  h.addEventListener('click',e=>{
    if(lastPointer==='touch'){ if(touchSel===s) go(s); touchSel=s; hovered=s; setSide(s,e.clientX,e.clientY); }
    else go(s);
  });
});
document.addEventListener('click',e=>{ if(lastPointer==='touch' && !e.target.closest('.hemi,.side')){ touchSel=null; hovered=null; setSide(null); } });
})();
</script>
</Base>
<style is:global>
html,body{height:100%}
body.world-home{background:var(--paper);color:var(--paper-fg);overflow:hidden}
:root{--cx:30%;--cy:50%}

/* resting split */
.base-dark{position:fixed;inset:0;background:var(--ink);clip-path:inset(0 50% 0 0)}
.home-grid{background-image:linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px);background-size:32px 32px}

/* left flood: a precise circle from the hemisphere, then the grid settles in and one scan line passes */
.flood-l{position:fixed;inset:0;background:var(--ink);clip-path:circle(0% at var(--cx) var(--cy));transition:clip-path .55s cubic-bezier(.7,0,.2,1)}
.flood-l .home-grid{position:absolute;inset:0;opacity:0;transition:opacity .2s}
.flood-l .scan{position:absolute;left:0;right:0;top:0;height:1px;background:linear-gradient(90deg,transparent,var(--volt),transparent);opacity:0}
body[data-side="left"] .flood-l{clip-path:circle(150% at var(--cx) var(--cy))}
body[data-side="left"] .flood-l .home-grid{opacity:1;transition:opacity .8s .35s}
body[data-side="left"] .flood-l .scan{animation:scan 1.4s .45s cubic-bezier(.4,0,.2,1) both}
@keyframes scan{0%{transform:translateY(0);opacity:0}10%{opacity:1}90%{opacity:.8}100%{transform:translateY(100vh);opacity:0}}

/* right flood: paint blobs splash out from the hemisphere, paper lands last */
.flood-r{position:fixed;inset:0;overflow:hidden;pointer-events:none}
.blob{position:absolute;left:var(--cx);top:var(--cy);width:var(--s);height:var(--s);margin:calc(var(--s) / -2) 0 0 calc(var(--s) / -2);
  border-radius:42% 58% 63% 37% / 41% 44% 56% 59%;transform:translate(var(--dx),var(--dy)) scale(0) rotate(0deg);
  transition:transform .35s cubic-bezier(.5,0,.75,0)}
body[data-side="right"] .blob{transform:translate(var(--dx),var(--dy)) scale(1) rotate(var(--rot));transition:transform .7s var(--d) cubic-bezier(.34,1.56,.64,1)}
.blob.b1{--s:38vmax;--dx:-6vmax;--dy:-8vmax;--rot:40deg;--d:0s;background:var(--p-pink)}
.blob.b5{--s:34vmax;--dx:14vmax;--dy:-10vmax;--rot:-60deg;--d:.09s;background:var(--p-blue);border-radius:55% 45% 38% 62% / 47% 60% 40% 53%}
.blob.b2{--s:44vmax;--dx:10vmax;--dy:6vmax;--rot:-30deg;--d:.06s;background:var(--p-yellow);border-radius:63% 37% 54% 46% / 55% 48% 52% 45%}
.blob.b3{--s:40vmax;--dx:-12vmax;--dy:12vmax;--rot:80deg;--d:.12s;background:var(--p-green);border-radius:38% 62% 46% 54% / 60% 35% 65% 40%}
.blob.b4{--s:300vmax;--dx:0px;--dy:0px;--rot:20deg;--d:.22s;background:var(--paper)}

/* line-drawn brain sitting on the seam */
.brain{position:fixed;left:50%;top:50%;width:min(46vh,40vw);aspect-ratio:400/440;transform:translate(-50%,-54%);overflow:visible}
.brain svg{width:100%;height:100%;overflow:visible;animation:float 5s ease-in-out infinite}
@keyframes float{50%{transform:translateY(-8px)}}
.brain .hemi{cursor:pointer}
.brain .hit{fill:transparent;stroke:none;pointer-events:all}
.brain path,.brain line,.brain circle{vector-effect:non-scaling-stroke}
.brain .outline{fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}
.brain .trace{fill:none;stroke-width:1.75;stroke-linecap:square;stroke-linejoin:miter}
.brain .node{stroke-width:1.75}
.brain .scrib{fill:none;stroke-width:2.25;stroke-linecap:round;stroke-linejoin:round}
.brain .draw{stroke-dasharray:1;stroke-dashoffset:0}
.hemi.l .outline,.hemi.l .trace{stroke:var(--volt-soft)} .hemi.l .node{fill:var(--ink);stroke:var(--volt-soft)}
.hemi.r .outline{stroke:var(--paper-fg)}
.hemi.r .c1{stroke:var(--p-red)} .hemi.r .c2{stroke:var(--p-blue)} .hemi.r .c3{stroke:var(--p-green)} .hemi.r .c4{stroke:var(--p-pink)} .hemi.r .c5{stroke:var(--p-yellow)}
.brain .scrib{stroke-width:2.75}
.hemi{transition:opacity .4s ease,transform .5s cubic-bezier(.34,1.56,.64,1)}
.hemi.l{transform-origin:200px 220px} .hemi.r{transform-origin:200px 220px}
/* the chosen half steps forward and redraws itself, the other half recedes */
body[data-side="left"] .hemi.l{transform:translateX(-10px) scale(1.04)}
body[data-side="left"] .hemi.r{opacity:.18}
body[data-side="left"] .hemi.r .outline{stroke:var(--ink-muted)}
body[data-side="left"] .hemi.l .trace{animation:drawLine .5s calc(var(--k) * 70ms + .15s) cubic-bezier(.6,0,.2,1) both}
body[data-side="left"] .hemi.l .node{animation:nodePop .3s calc(var(--k) * 70ms + .6s) ease-out both}
body[data-side="left"] .hemi.l .outline{stroke:#FFFFFF}
body[data-side="right"] .hemi.r{transform:translateX(10px) scale(1.04) rotate(2deg)}
body[data-side="right"] .hemi.l{opacity:.25}
body[data-side="right"] .hemi.l .outline,body[data-side="right"] .hemi.l .trace{stroke:var(--paper-muted)}
body[data-side="right"] .hemi.l .node{fill:var(--paper);stroke:var(--paper-muted)}
body[data-side="right"] .hemi.r .scrib{animation:drawLine .7s calc(var(--k) * 110ms + .2s) cubic-bezier(.34,1.3,.64,1) both, wiggle 1.6s calc(var(--k) * 110ms + 1s) ease-in-out infinite}
body[data-side="right"] .hemi.r .outline{animation:wiggleO 2.4s .8s ease-in-out infinite}
@keyframes drawLine{from{stroke-dashoffset:1}to{stroke-dashoffset:0}}
@keyframes nodePop{0%{transform:scale(0)}70%{transform:scale(1.5)}100%{transform:scale(1)}}
.node{transform-box:fill-box;transform-origin:center}
.scrib,.hemi.r .outline{transform-box:fill-box;transform-origin:center}
@keyframes wiggle{50%{transform:rotate(-2.5deg) translateY(-1.5px)}}
@keyframes wiggleO{50%{transform:scale(1.012) rotate(.6deg)}}

.top{position:fixed;top:calc(20px + env(safe-area-inset-top,0px));left:0;right:0;display:flex;flex-direction:column;align-items:center;gap:10px;pointer-events:none;
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
h1.pill{margin:0;font-weight:400;font-family:var(--mono);font-size:13px;letter-spacing:.08em;padding:8px 16px;border-radius:999px;background:#FFFFFF;color:var(--ink);box-shadow:0 2px 14px rgba(0,0,0,.18)}
.hint{font-family:var(--mono);font-size:12px;letter-spacing:.06em;color:#4A4F5C;background:#FFFFFF;padding:4px 10px;border-radius:999px;box-shadow:0 1px 8px rgba(0,0,0,.12)}

.side{position:fixed;bottom:calc(36px + env(safe-area-inset-bottom,0px));max-width:min(400px,42vw);text-decoration:none;display:flex;flex-direction:column;gap:12px;
  transition:opacity .3s ease,visibility .3s;border-radius:8px}
.side:focus-visible{outline:3px solid var(--volt);outline-offset:8px}
.side.l{left:max(40px,calc(env(safe-area-inset-left,0px) + 24px));color:var(--ink-fg)}
.side.r{right:max(40px,calc(env(safe-area-inset-right,0px) + 24px));text-align:right;align-items:flex-end;color:var(--paper-fg)}
/* the unselected side leaves the stage completely */
body[data-side="left"] .side.r, body[data-side="right"] .side.l{opacity:0;visibility:hidden}

.eyebrow{font-family:var(--mono);font-size:13px;letter-spacing:.1em}
.l .eyebrow{color:var(--volt-soft)} .r .eyebrow{color:var(--paper-fg);background:linear-gradient(transparent 55%,var(--p-yellow) 55%,var(--p-yellow) 92%,transparent 92%);padding:0 4px}
.l h2{margin:0;font-family:var(--sans);font-weight:600;font-size:clamp(30px,4vw,56px);line-height:1;letter-spacing:-.02em}
.r h2{margin:0;font-family:var(--serif);font-style:italic;font-weight:400;font-size:clamp(36px,4.8vw,68px);line-height:.95}
.side p{margin:0;font-size:16px;line-height:1.5}
.l p{color:var(--ink-muted)} .r p{color:var(--paper-muted)}
.go{display:inline-flex;align-items:center;gap:8px;font-size:15px;transition:transform .3s ease}
.l .go{font-family:var(--mono);color:#FFFFFF} .r .go{font-family:var(--serif);font-style:italic;font-size:21px;color:var(--paper-fg);background:linear-gradient(transparent 60%,var(--p-pink) 60%,var(--p-pink) 90%,transparent 90%);padding:0 4px}
.side:hover .go{transform:translateX(6px)} .r:hover .go{transform:translateX(-6px)}

/* left micro-motion: terminal typing, lines rising out of masks */
.line{display:block;overflow:hidden}
.line > span{display:block}
.type{display:inline-block;overflow:hidden;white-space:nowrap;vertical-align:bottom}
.caret{display:inline-block;width:.6em;height:1.1em;background:var(--volt);vertical-align:-3px;margin-left:2px;opacity:0}
body[data-side="left"] .l .eyebrow .type{animation:typing .5s steps(10) both}
body[data-side="left"] .l .line > span{animation:rise .6s cubic-bezier(.2,.8,.2,1) both}
body[data-side="left"] .l .line:nth-child(2) > span{animation-delay:.08s}
body[data-side="left"] .l p{animation:fade .6s .25s both}
body[data-side="left"] .l .go .type{animation:typing .45s .45s steps(8) both}
body[data-side="left"] .l .caret{opacity:1;animation:blink 1s .9s steps(1) infinite}
@keyframes typing{from{max-width:0}to{max-width:12em}}
@keyframes rise{from{transform:translateY(105%)}to{transform:none}}
@keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
@keyframes blink{50%{opacity:0}}

/* right micro-motion: bouncy letters, a cat peeking over the headline, paw prints, doodles */
.r h2 .ch{display:inline-block;white-space:pre}
body[data-side="right"] .r h2 .ch{animation:hop .9s calc(var(--i) * 35ms) cubic-bezier(.34,1.56,.64,1) both, bob 2.6s calc(.9s + var(--i) * 90ms) ease-in-out infinite}
@keyframes hop{0%{transform:translateY(.5em) rotate(8deg);opacity:0}100%{transform:none;opacity:1}}
@keyframes bob{0%,100%{transform:none}50%{transform:translateY(-.06em) rotate(-2deg)}}
body[data-side="right"] .r p{animation:fade .6s .35s both}

.cat{position:absolute;right:4px;bottom:calc(100% - 2px);width:96px;height:64px;overflow:hidden;pointer-events:none}
.cat svg{position:absolute;left:0;bottom:-6px;transform:translateY(100%);transition:transform .3s ease-in}
body[data-side="right"] .cat svg{transform:none;transition:transform .55s .35s cubic-bezier(.34,1.56,.64,1)}
.cat .ear-l{transform-origin:30px 30px} .cat .ear-r{transform-origin:66px 30px}
body[data-side="right"] .cat .ear-r{animation:twitch 2.8s 1.4s ease-in-out infinite}
.cat .lids{transform-origin:48px 40px;transform:scaleY(0)}
body[data-side="right"] .cat .lids{animation:blinkcat 3.4s 1.2s infinite}
@keyframes twitch{0%,86%,100%{transform:none}90%{transform:rotate(-14deg)}94%{transform:rotate(4deg)}}
@keyframes blinkcat{0%,92%,100%{transform:scaleY(0)}95%{transform:scaleY(1)}}

.paws{position:fixed;left:0;right:0;bottom:calc(12px + env(safe-area-inset-bottom,0px));height:60px;pointer-events:none}
.paw{position:absolute;width:28px;height:28px;color:var(--paper-fg);opacity:0}
body[data-side="right"] .paw{animation:paw 2.6s calc(.5s + var(--i) * .22s) ease-out both}
@keyframes paw{0%{opacity:0;transform:scale(.4) rotate(var(--r))}15%{opacity:.4;transform:scale(1) rotate(var(--r))}70%{opacity:.4}100%{opacity:0;transform:scale(1) rotate(var(--r))}}

.doodle{position:fixed;pointer-events:none;opacity:0;color:var(--p-red)}
body[data-side="right"] .doodle{animation:doodle .7s var(--d) cubic-bezier(.34,1.56,.64,1) both, spin 6s calc(var(--d) + .7s) linear infinite}
@keyframes doodle{from{opacity:0;transform:scale(0) rotate(-90deg)}to{opacity:1;transform:none}}
@keyframes spin{to{transform:rotate(360deg)}}


@media (max-width:640px){
  .side{max-width:none;gap:6px}
  .side.l{top:calc(110px + env(safe-area-inset-top,0px));bottom:auto;left:max(16px,env(safe-area-inset-left,0px));right:max(16px,env(safe-area-inset-right,0px))}
  .side.r{bottom:calc(28px + env(safe-area-inset-bottom,0px));right:max(16px,env(safe-area-inset-right,0px));left:max(16px,env(safe-area-inset-left,0px))}
  .side p{display:none}
  .base-dark{clip-path:inset(0 0 50% 0)}
  .doodle{display:none}
  .brain{width:min(56vw,36vh);transform:translate(-50%,-50%) rotate(90deg)}
}
</style>
