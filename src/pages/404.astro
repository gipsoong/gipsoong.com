---
import Base from '../layouts/Base.astro';
---
<Base title="Lost · Ryan Gip Soong" description="This page doesn't exist." world="play">
  <main id="main" class="wrap lost">
    <svg class="rough" width="120" height="80" viewBox="0 0 120 80" aria-hidden="true"><path d="M10 60 C 30 10, 50 70, 70 30 S 110 40, 110 20" fill="none" stroke="var(--p-red)" stroke-width="3" stroke-linecap="round"/></svg>
    <h1>This page wandered off.</h1>
    <p>Try the <a href="/work">work side</a>, the <a href="/play">play side</a> or the <a href="/">start</a>.</p>
  </main>
</Base>
<style>
  .lost{min-height:80vh;display:flex;flex-direction:column;justify-content:center;gap:12px}
  h1{margin:0;font:400 clamp(44px,7vw,88px)/1 var(--serif)}
  p{font-size:18px;color:var(--paper-muted)}
</style>
