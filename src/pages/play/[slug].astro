---
import Base from '../../layouts/Base.astro';
import PlayHeader from '../../components/PlayHeader.astro';
import { getPhotoSets, img, type PhotoSet } from '../../lib/content';
export async function getStaticPaths() {
  return (await getPhotoSets()).map((set) => ({ params: { slug: set.slug }, props: { set } }));
}
const { set } = Astro.props as { set: PhotoSet };
const tint = set.tint || 'yellow';
---
<Base title={`${set.title} · Play · Ryan Gip Soong`} description={set.blurb} world="play">
  <PlayHeader />
  <main id="main" class="wrap">
    <a class="back" href="/play">← all sets</a>
    <h1><span class="hl" style={`--hl:var(--p-${tint})`}>{set.title}</span></h1>
    <p class="blurb">{set.blurb}</p>
    <div class="gallery">
      {set.photos.map((p, i) => {
        const src = img(p.image, 1200);
        return (
          <figure style={`--tilt:${[-0.6, 0.5, -0.3, 0.7][i % 4]}deg`}>
            {src ? <img src={src} alt={p.image?.alt || p.caption || ''} loading="lazy" width="1200" height="900" /> : <span class="photo-ph" style={`--bg:var(--p-${tint})`} aria-hidden="true">[PHOTO {i + 1}]</span>}
            {p.caption && <figcaption>{p.caption}</figcaption>}
          </figure>
        );
      })}
    </div>
  </main>
</Base>
<style>
  main{padding-block:24px 96px}
  .back{font:14px var(--mono);color:var(--paper-muted)}
  h1{margin:28px 0 12px;font:400 clamp(48px,8vw,104px)/1 var(--serif)}
  .blurb{max-width:560px;font-size:18px;color:var(--paper-muted);margin:0 0 48px}
  .gallery{columns:3 280px;column-gap:24px}
  figure{break-inside:avoid;margin:0 0 24px;background:var(--paper-2);padding:10px 10px 12px;box-shadow:0 6px 18px rgba(30,30,30,.08);transform:rotate(var(--tilt))}
  figure img,.photo-ph{display:block;width:100%}
  .photo-ph{aspect-ratio:4/3;display:flex;align-items:center;justify-content:center;background:color-mix(in srgb,var(--bg) 30%,#fff);font:13px var(--mono);color:#555}
  figure:nth-child(3n) .photo-ph{aspect-ratio:3/4}
  figcaption{margin-top:8px;font:13px var(--mono);color:var(--paper-muted)}
</style>
