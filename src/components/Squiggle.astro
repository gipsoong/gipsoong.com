---
interface Props { color?: string; width?: number }
const { color = 'var(--volt)', width = 220 } = Astro.props;
---
<svg class="squiggle rough" width={width} height="18" viewBox="0 0 220 18" preserveAspectRatio="none" aria-hidden="true">
  <path d="M3 11 C 30 2, 50 17, 78 9 S 128 3, 152 10 S 200 15, 217 6" fill="none" stroke={color} stroke-width="3" stroke-linecap="round" />
</svg>
<style>.squiggle{display:block;overflow:visible;max-width:100%}</style>
