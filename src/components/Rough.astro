---
// One shared SVG filter that gives lines a hand-drawn wobble. Reseeding it a few times a second makes the lines "boil".
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true" transition:persist="rough">
  <filter id="rough" x="-5%" y="-5%" width="110%" height="110%">
    <feTurbulence id="roughNoise" type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="3" />
    <feDisplacementMap in="SourceGraphic" scale="5" />
  </filter>
</svg>
<script>
  const n = document.getElementById('roughNoise');
  if (n && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let seed = 3;
    setInterval(() => { seed = (seed % 4) + 1; n.setAttribute('seed', String(seed)); }, 220);
  }
</script>
